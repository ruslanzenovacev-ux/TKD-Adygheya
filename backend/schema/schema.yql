-- Схема YDB. Генерируется из src/repo/tables.js: node scripts/gen-schema.js > schema/schema.yql
-- Каждая запись хранится целиком в doc (Json), поисковые поля продублированы в колонки с индексами.

CREATE TABLE IF NOT EXISTS `users` (
    id Utf8 NOT NULL,
    doc Json,
    email Utf8,
    INDEX idx_email GLOBAL SYNC ON (email),
    PRIMARY KEY (id)
);

CREATE TABLE IF NOT EXISTS `sessions` (
    id Utf8 NOT NULL,
    doc Json,
    PRIMARY KEY (id)
);

CREATE TABLE IF NOT EXISTS `loginCodes` (
    id Utf8 NOT NULL,
    doc Json,
    PRIMARY KEY (id)
);

CREATE TABLE IF NOT EXISTS `invites` (
    id Utf8 NOT NULL,
    doc Json,
    PRIMARY KEY (id)
);

CREATE TABLE IF NOT EXISTS `groups` (
    id Utf8 NOT NULL,
    doc Json,
    trainerId Utf8,
    INDEX idx_trainerId GLOBAL SYNC ON (trainerId),
    PRIMARY KEY (id)
);

CREATE TABLE IF NOT EXISTS `plans` (
    id Utf8 NOT NULL,
    doc Json,
    PRIMARY KEY (id)
);

CREATE TABLE IF NOT EXISTS `children` (
    id Utf8 NOT NULL,
    doc Json,
    parentId Utf8,
    groupId Utf8,
    INDEX idx_parentId GLOBAL SYNC ON (parentId),
    INDEX idx_groupId GLOBAL SYNC ON (groupId),
    PRIMARY KEY (id)
);

CREATE TABLE IF NOT EXISTS `packages` (
    id Utf8 NOT NULL,
    doc Json,
    childId Utf8,
    INDEX idx_childId GLOBAL SYNC ON (childId),
    PRIMARY KEY (id)
);

CREATE TABLE IF NOT EXISTS `attendance` (
    id Utf8 NOT NULL,
    doc Json,
    childId Utf8,
    groupDate Utf8,
    INDEX idx_childId GLOBAL SYNC ON (childId),
    INDEX idx_groupDate GLOBAL SYNC ON (groupDate),
    PRIMARY KEY (id)
);

CREATE TABLE IF NOT EXISTS `payments` (
    id Utf8 NOT NULL,
    doc Json,
    childId Utf8,
    providerId Utf8,
    month Utf8,
    INDEX idx_childId GLOBAL SYNC ON (childId),
    INDEX idx_providerId GLOBAL SYNC ON (providerId),
    INDEX idx_month GLOBAL SYNC ON (month),
    PRIMARY KEY (id)
);

